rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---
    function isValidFolder(data) {
      return data.keys().hasAll(['name', 'date']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.date is timestamp;
    }

    function isValidAsset(data) {
      return data.keys().hasAll(['name', 'type', 'captureDate', 'uploadDate', 'folderId', 'ownerId', 'versions']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 255 &&
             data.type in ['image', 'video', 'document'] &&
             data.captureDate is timestamp &&
             data.uploadDate is timestamp &&
             data.folderId is string && isValidId(data.folderId) &&
             data.ownerId == request.auth.uid &&
             data.versions is list && data.versions.size() > 0 && data.versions.size() <= 10 &&
             exists(/databases/$(database)/documents/folders/$(data.folderId));
    }

    // --- Rules ---

    // Admins collection - only readable by signed in users, writable only by existing admins
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via Google Cloud Console or restricted backend
    }

    match /folders/{folderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidFolder(incoming());
      allow update: if isSignedIn() && isValidFolder(incoming()) && (
        isAdmin() || (isOwner(existing().get('ownerId', '')) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description']))
      );
      allow delete: if isAdmin();
    }

    match /assets/{assetId} {
      allow read: if isSignedIn() && (isAdmin() || isOwner(existing().ownerId));
      allow create: if isSignedIn() && isValidAsset(incoming()) && incoming().uploadDate == request.time;
      allow update: if isSignedIn() && isValidAsset(incoming()) && (
        isAdmin() || (isOwner(existing().ownerId) && incoming().ownerId == existing().ownerId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'versions']))
      );
      allow delete: if isSignedIn() && (isAdmin() || isOwner(existing().ownerId));
    }
  }
}
